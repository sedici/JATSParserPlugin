<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 20px 0;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f9f9f9;
        }
        img {
            display: block;
            margin: auto;
            width: 50%;
        }
        blockquote {
            border-left: 5px solid #4A90E2;
            background: #f5f7fa;
            margin: 20px 0;
            padding: 16px 24px;
            font-style: italic;
            color: #333;
            box-shadow: 0 2px 8px rgba(74,144,226,0.08);
            border-radius: 6px;
        }
    </style>
</head>
<body>
    Test
</body>
</html>