msgid "plugins.generic.jatsParser.publication.jats.group.citations"
msgstr "2. Citation Assignment"

msgid "plugins.generic.jatsParser.publication.jats.group.citations.description"
msgstr "Allows reviewing and customizing the linking of citations, bibliographic references, figures, and tables from the selected XML file."

msgid "plugins.generic.jatsParser.publication.jats.citations.noXmlSelected"
msgstr "Select an XML file in the previous section and click \"Save\" in the lower right corner to enable citation assignment."

msgid "plugins.generic.jatsParser.publication.jats.citations.cardTitle"
msgstr "Reference and citation mapping"

msgid "plugins.generic.jatsParser.publication.jats.citations.cardDescription"
msgstr "Open the interactive table to manually map or adjust in-text citations with their respective bibliographic references, figures, or tables according to the journal's configured citation style."

msgid "plugins.generic.jatsParser.publication.jats.citations.styleLabel"
msgstr "Active style"

msgid "plugins.generic.jatsParser.publication.jats.citations.statusConfigured"
msgstr "Custom citations configured"

msgid "plugins.generic.jatsParser.publication.jats.citations.styleNotSupported"
msgstr "The current citation style ({$style}) does not require manual custom citation assignment."

msgid "plugins.generic.jatsParser.publication.jats.group.htmlOutput"
msgstr "3. Publication HTML (SUMARC)"

msgid "plugins.generic.jatsParser.publication.jats.group.htmlOutput.description"
msgstr "Configuration for displaying full-text interactive HTML on the article page using the SUMARC template."

msgid "plugins.generic.jatsParser.publication.jats.html.label"
msgstr "HTML Generation"

msgid "plugins.generic.jatsParser.publication.jats.html.checkboxLabel"
msgstr "Generate / Update Publication HTML"

msgid "plugins.generic.jatsParser.publication.jats.html.description"
msgstr "Transforms the selected XML and publishes the enriched full-text HTML (interactive figures, formulas, and citations) on the article page for this language."

msgid "plugins.generic.jatsParser.publication.jats.html.activeTitle"
msgstr "Publication HTML is active"

msgid "plugins.generic.jatsParser.publication.jats.html.alertOverwrite"
msgstr "Notice: Publication HTML is already generated for this language. If you keep the generation option selected upon saving, current content will be overwritten with the selected XML file."

msgid "plugins.generic.jatsParser.publication.jats.html.deleteBtn"
msgstr "Delete Publication HTML"

msgid "plugins.generic.jatsParser.publication.jats.html.deleteConfirmTitle"
msgstr "Confirm Publication HTML Deletion"

msgid "plugins.generic.jatsParser.publication.jats.html.deleteConfirmText"
msgstr "Are you sure you want to delete the publication HTML for this language? The SUMARC enriched viewer will be removed from the article landing page, reverting to OJS's default display."

msgid "plugins.generic.jatsParser.publication.jats.html.deletedSuccess"
msgstr "Publication HTML successfully deleted. The publication has reverted to the default OJS view."

msgid "plugins.generic.jatsParser.publication.jats.group.pdfOutput"
msgstr "4. PDF Galley"

msgid "plugins.generic.jatsParser.publication.jats.group.pdfOutput.description"
msgstr "Configuration for compiling and registering an independent downloadable PDF galley."

msgid "plugins.generic.jatsParser.publication.jats.pdf.checkboxLabel"
msgstr "Generate PDF Galley"

msgid "plugins.generic.jatsParser.publication.jats.pdf.description"
msgstr "Independently compiles and creates (or updates) a downloadable PDF galley in the OJS Galleys section from the selected XML."


