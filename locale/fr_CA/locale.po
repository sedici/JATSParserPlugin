msgid "plugins.generic.jatsParser.publication.jats.description"
msgstr "Sélectionnez un fichier prêt pour la production au format JATS XML afin de créer le texte intégral."

msgid "plugins.generic.jatsParser.publication.jats.descriptionEmpty"
msgstr "La liste des fichiers JATS XML est vide. Veuillez téléverser le fichier dans l’étape de production et il apparaîtra ci-dessous pour la génération du texte intégral."

msgid "plugins.generic.jatsParser.publication.jats.references.label"
msgstr "Récupérer les références depuis le JATS XML ?"

msgid "plugins.generic.jatsParser.publication.jats.references.description"
msgstr "La liste des références sera extraite du JATS XML et enregistrée comme partie de la publication. Si des références existent déjà dans la publication, elles seront remplacées."

