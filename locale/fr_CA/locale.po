msgid "plugins.generic.jatsParser.galley.import"
msgstr "Importation des épreuves JATS XML"

msgid "plugins.generic.jatsParser.galley.import.description"
msgstr "Cette option permet d’enregistrer les épreuves JATS XML comme texte intégral dans toutes les publications de la revue. L’importation est ignorée si une publication possède déjà un texte intégral pour une épreuve donnée. L’importation commence immédiatement après l’enregistrement du formulaire."

msgid "plugins.generic.jatsParser.galley.import.title"
msgstr "Importer le texte intégral depuis les épreuves"

